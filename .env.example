# ─── Supabase ───────────────────────────────────────────────────────
# Required unless VITE_MOCK_MODE=true. The app throws on startup if these
# are missing while not in mock mode (see src/lib/supabase.js).
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── Mock mode ──────────────────────────────────────────────────────
# "true" bypasses Supabase and renders example player data for UI preview.
# Leave unset/false for any real or production build.
VITE_MOCK_MODE=false

# ─── Web Push (Phase 2) ─────────────────────────────────────────────
# Public VAPID key for browser push subscriptions. Generate a key pair and
# keep the private half as an Edge Function secret (never expose it here).
VITE_VAPID_PUBLIC_KEY=

# ─── Payments (Phase 3) ─────────────────────────────────────────────
# Stripe publishable key (safe to expose). Secret key + webhook signing
# secret live as Edge Function secrets, not in the client bundle.
VITE_STRIPE_PUBLISHABLE_KEY=

# ─── Custom booking (Phase 4) ───────────────────────────────────────
# Cloudflare Turnstile site key for the public booking form (safe to
# expose). The secret half is an Edge Function secret (TURNSTILE_SECRET).
VITE_TURNSTILE_SITE_KEY=
# Base URL of the Supabase Edge Functions, used by the marketing website
# to call create-booking / get available slots, e.g.
# https://<project-ref>.functions.supabase.co
VITE_FUNCTIONS_URL=

# ─── Edge Function secrets (NOT client env — set via `supabase secrets set`) ──
# These never go in the bundle; listed here only as a deployment checklist:
#   TURNSTILE_SECRET                 Cloudflare Turnstile secret (bot check)
#   WEBSITE_ORIGIN                   CORS allowlist, e.g. https://stylzzbycliff.com
#   WEBSITE_URL                      Deposit Checkout return target (booking confirm page)
#   GOOGLE_OAUTH_CLIENT_ID/SECRET    One-way Google Calendar sync
#   RESEND_API_KEY / BROADCAST_FROM  Booking-confirmation emails (shared w/ broadcasts)
